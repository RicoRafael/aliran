# ─────────────────────────────────────────────────────────────────────────
#  STRATA — ETL environment
#  Copy this file to `etl/.env` and paste your key there.
#  `etl/.env` is gitignored. NEVER commit it. NEVER paste the key in chat.
# ─────────────────────────────────────────────────────────────────────────

# From https://sectors.app/api  (API Keys section)
# The Sectors REST API expects the RAW key in the Authorization header —
# no "Bearer " prefix. (The MCP server is the one that needs "Bearer ".)
SECTORS_API_KEY=paste_your_key_here

# Hard ceiling for THIS run. The client refuses any call that would exceed
# it and raises CreditExhausted. Tranches from MASTER.md §8:
#   T0 spike = 40 | T1 = 260 | T2 = 260 | T3 = 140 | RESERVE = 300 (untouchable)
STRATA_TRANCHE_CAP=40

# Set to 1 to forbid ALL network calls and serve only from fixtures/raw/.
# This is the offline replay path — tests and demos run at zero credits.
STRATA_OFFLINE=0
